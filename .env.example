# ============================================================
#  要在 Coolify 的 Environment Variables 設定這些值
#  這個檔案只是範本，不要把真實密碼寫進來（它會進 git）
# ============================================================

# Zoho SMTP 主機
#   免費個人版      -> smtp.zoho.com
#   付費組織版      -> smtppro.zoho.com
#   歐洲區帳號      -> smtp.zoho.eu
SMTP_HOST=smtp.zoho.com

# 465 = SSL（建議）　587 = STARTTLS
SMTP_PORT=465

# 你的 Zoho 完整信箱位址
SMTP_USER=you@yourdomain.com

# Zoho 的「應用程式專用密碼」，不是登入密碼
# 產生位置：Zoho Mail -> 設定 -> 安全性 -> 應用程式專用密碼
SMTP_PASS=

# 寄件人位址，必須跟 SMTP_USER 相同（Zoho 規定，否則會被拒收）
MAIL_FROM=you@yourdomain.com

# 你要收訂單副本的信箱（可以跟上面一樣）
MAIL_TO=you@yourdomain.com

# 信件標題與內文用的名稱
SITE_NAME=中元普渡法會

# 設成 1 就只印在 log 不真的寄信，用來測試
MAIL_DRYRUN=0
